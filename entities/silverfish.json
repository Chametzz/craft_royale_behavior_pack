    "events": {
      "minecraft:become_angry": {
        "add": {
          "component_groups": [
            "minecraft:silverfish_angry"
          ]
        },
        "remove": {
          "minecraft:silverfish_calm": {}
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "minecraft:silverfish_calm"
          ]
        },
        "remove": {}
      },
      "minecraft:on_calm": {
        "add": {
          "component_groups": [
            "minecraft:silverfish_calm"
          ]
        },
        "remove": {
          "minecraft:silverfish_angry": {}
        }
      },
      "craft_royale:remove_teams": {
        "remove": {
          "component_groups": []
        }
