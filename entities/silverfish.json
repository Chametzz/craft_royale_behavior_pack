                        "subject": "other",
                        "value": "blue_team"
                      }
                    ]
                  },
                  {
                    "all_of": [
                      {
                        "test": "has_tag",
                        "value": "red_team"
                      },
                      {
                        "test": "has_tag",
                        "subject": "other",
                        "value": "red_team"
                      }
                    ]
                  }
                ]
              }
            },
