          "priority": 2,
          "must_see": true,
          "reselect_targets": true,
          "within_radius": 64,
          "entity_types": [
            {
              "filters": {
                "AND": [
                  {
                    "test": "is_family",
                    "subject": 1,
                    "operator": 1,
                    "value": "blue_team"
                  }
                ]
              },
              "max_dist": 35
            }
          ]
        },
        "minecraft:damage_sensor": {
          "triggers": [
