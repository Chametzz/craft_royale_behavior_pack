                          "value": "blue_team"
                        },
                        {
                          "test": "has_tag",
                          "subject": "other",
                          "value": "blue_team"
                        }
                      ]
                    },
                    {
                      "all_of": [
                        {
                          "test": "is_family",
                          "value": "blue_team"
                        },
                        {
                          "test": "is_family",
